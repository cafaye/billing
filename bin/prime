#!/usr/bin/env bash
#
# Prime this worktree. Run it after `git clone`, `git worktree add`, or
# `git pull --rebase`, and it is what CI runs.
#
#   bin/prime            # bundle, prepare the database, lint, then the suite
#   bin/prime --fast     # bundle and the database only
#
# WHAT IT PROMISES
#   Exit 0: dependencies resolve, the database is prepared, the linter is
#   clean, and every test passes. Anything else: nonzero, with the failing step
#   named. `set -euo pipefail` is the whole mechanism — no error handling to
#   forget.
#
# STRICTNESS NOTES
#   - No `mise install` here. mise.toml pins the interpreter; this script fails
#     loudly (127) with instructions instead of installing a toolchain behind
#     your back.
#   - `bundle install`, never `bundle update`: a prime that moves the lockfile
#     can make two worktrees disagree about the same commit.
#   - Rubocop runs before the tests: a formatting offense should cost a second,
#     not a full suite run.
#   - `db:prepare` before the tests so a first run on a clean checkout does not
#     fail on a missing database.

set -euo pipefail

FAST=0
for arg in "$@"; do
  case "$arg" in
    --fast) FAST=1 ;;
    -h | --help)
      sed -n '2,20p' "$0"
      exit 0
      ;;
    *)
      echo "bin/prime: unknown argument: $arg" >&2
      exit 2
      ;;
  esac
done

require() {
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "bin/prime: $1 not found on PATH — run 'mise install' in this worktree" >&2
    exit 127
  fi
}

step() {
  printf '\n== %s\n' "$1"
}

# Never fails the prime. The toolchain checks below are the gate; a banner must
# not be able to turn a green prime red.
version_of() {
  "$@" --version 2>/dev/null | head -n 1 || true
}

require ruby
require bundle

step "ruby $(version_of ruby)"

step "bundle install"
bundle install

if [ "$FAST" -eq 1 ]; then
  step "skipping the database, lint and tests (--fast)"
  exit 0
fi

step "rails db:prepare"
bundle exec rails db:prepare

if bundle exec rubocop --version >/dev/null 2>&1; then
  step "rubocop"
  bundle exec rubocop --parallel
else
  echo "bin/prime: rubocop is not in the bundle — skipping lint (add it to the Gemfile)" >&2
fi

step "rails test"
bundle exec rails test

step "prime ok (rails $(version_of bin/rails))"
